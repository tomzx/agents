# SDLC configuration (~/.sdlc/config.yaml)
#
# Copy this file to ~/.sdlc/config.yaml and customize.
# Read by ~/.agents/scripts/should-post-to-github to decide whether
# skills may post content to GitHub (PR creation, PR description updates,
# comments, reviews). Git write operations (push, merge, deploy) are not gated.

# Global kill switch. Set to false to suppress all GitHub comment posting.
# Default is true when the key is absent.
post_github_comments: true

# Repository owners whose PRs should never receive automated comments.
excluded_owners:
  # - some-company
  # - some-org

# Specific repositories (owner/repo) to exclude.
excluded_repos:
  # - owner/repo
  # - other-org/big-repo

# PR authors whose PRs should never receive automated comments.
excluded_authors:
  # - dependabot
  # - renovate
